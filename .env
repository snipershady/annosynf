# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# MySQL >= 8.4 (in locale 9.7), database e utente "annosynf", utf8mb4 / utf8mb4_0900_ai_ci (doctrine.yaml).
# La password reale va in .env.local (git-ignored) o nel vault: mai qui.
DATABASE_URL="mysql://annosynf:!ChangeMe!@127.0.0.1:3306/annosynf?serverVersion=9.7.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> app/redis ###
# Redis >= 8: cache.app, sessioni HTTP, lock, code Messenger (§B.5.3).
REDIS_URL=redis://127.0.0.1:6379
###< app/redis ###

###> symfony/messenger ###
# Code su Redis Streams (redis-messenger); i messaggi falliti finiscono su Doctrine (transport "failed").
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6379/messages
# Coda degli import delle release (stream Redis separato: un task può durare ore e non deve bloccare le altre code)
MESSENGER_IMPORT_TRANSPORT_DSN=redis://127.0.0.1:6379/import
###< symfony/messenger ###

###> symfony/lock ###
# Lock condivisi tra web e worker, anche su host diversi.
LOCK_DSN=redis://127.0.0.1:6379
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> app/mailer ###
# Mittente delle e-mail dell'applicazione; deve essere un indirizzo accettato dal provider SMTP.
MAILER_FROM_ADDRESS=no-reply@annosynf.example
###< app/mailer ###

###> app/blast ###
# Directory dei binari NCBI BLAST+ (blastx, blastp, blastn, tblastn, rpstblastn, rpsblast, makeblastdb,
# blastdbcmd). NON vendorizzati in git: si sovrascrive in .env.local con il path reale della macchina.
# Aggiornare BLAST+ = scaricare il pacchetto ufficiale NCBI e cambiare questo valore.
BLAST_BIN_DIR=/usr/local/ncbi/blast/bin
# Durata massima di un singolo processo BLAST+ (o makeblastdb/blastdbcmd), in secondi.
BLAST_TIMEOUT=86400
# Database BLAST costruiti dalle release (fuori da git e da var/, che si può svuotare).
BLAST_DB_DIR=%kernel.project_dir%/blastdb
###< app/blast ###

###> app/annosynf ###
# File di lavoro (FASTA, output grezzi, export): non sono la fonte di verità, che è il DB (§B.4.3).
ANNOSYNF_STORAGE_DIR=%kernel.project_dir%/var/storage
# Job BLAST concorrenti (semaforo su Redis) e thread per job (-num_threads).
ANNOSYNF_MAX_BLAST_JOBS=2
ANNOSYNF_THREADS_PER_JOB=4
###< app/annosynf ###

###> app/altcha ###
# Chiave con cui si firmano le sfide ALTCHA (proof of work): una stringa casuale per macchina, in
# .env.local. Mai riusare quella di un altro progetto.
ALTCHA_KEY=!ChangeMe!
# Difficoltà per scopo: low, medium, medium_high, high, very_high (vedi App\Security\Altcha\AltchaDifficulty).
ALTCHA_LOGIN_DIFFICULTY=medium_high
ALTCHA_REGISTRATION_DIFFICULTY=medium_high
# Verifica di sicurezza prima della home per gli anonimi.
ALTCHA_SECURITY_CHECK_DIFFICULTY=high
# Pagina "nopainnogain" dei 404: pensata per far sprecare CPU ai bot.
ALTCHA_TRAP_DIFFICULTY=very_high
# Durata, in secondi, del cookie che prova il superamento della verifica di sicurezza.
SECURITY_CHECK_COOKIE_LIFETIME=3600
###< app/altcha ###

###> symfony/slack-notifier ###
# Transport chatter del Notifier (non usato dagli errori, che passano da Monolog).
SLACK_DSN=null://null
# Handler Monolog `slack_error` (livello error, dev e prod). Il token reale va in .env.local o nel
# vault, mai qui.
SLACK_TOKEN=!ChangeMe!
SLACK_CHANNEL=annosynf-error-log
SLACK_BOT_NAME=annosynf
###< symfony/slack-notifier ###
