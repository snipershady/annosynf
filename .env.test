# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Directory di lavoro e database BLAST dei test, separati da quelli di sviluppo
ANNOSYNF_STORAGE_DIR=%kernel.project_dir%/var/test/storage
BLAST_DB_DIR=%kernel.project_dir%/var/test/blastdb

# Messenger in memoria: i test ispezionano i messaggi senza un worker
MESSENGER_TRANSPORT_DSN=in-memory://
MESSENGER_IMPORT_TRANSPORT_DSN=in-memory://
# Lock su file: i test non dipendono da Redis
LOCK_DSN=flock
MAILER_FROM_ADDRESS=no-reply@annosynf.example

# Proof of work istantanea e chiave fissa: i test risolvono davvero le sfide
ALTCHA_KEY=test-only-altcha-key
ALTCHA_LOGIN_DIFFICULTY=low
ALTCHA_REGISTRATION_DIFFICULTY=low
ALTCHA_SECURITY_CHECK_DIFFICULTY=low
ALTCHA_TRAP_DIFFICULTY=low
SECURITY_CHECK_COOKIE_LIFETIME=3600
